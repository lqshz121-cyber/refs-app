{
  "name": "refs-accounting-kernel",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "pg:start": "docker compose -f compose.yaml up -d --wait && node runtime/migrate.mjs up",
    "pg:stop": "docker compose -f compose.yaml down",
    "db:up": "node runtime/migrate.mjs up",
    "db:down": "node runtime/migrate.mjs down",
    "db:reset": "node runtime/migrate.mjs reset",
    "test:postgres": "node --test tests/postgres-kernel.test.mjs",
    "test:postgres:fresh": "node runtime/test-postgres-fresh.mjs"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
