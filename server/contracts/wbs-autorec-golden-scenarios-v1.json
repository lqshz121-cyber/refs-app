{
  "contract": "WBS_AUTOREC_GOLDEN_SCENARIOS_V1",
  "classification": "SANITIZED_LOCAL_ACCEPTANCE_EVIDENCE",
  "production_evidence_required": "Signed nonempty provider receipts and persisted REFS readback are required before any scenario can be treated as production evidence.",
  "scenarios": [
    {
      "id": "exact_one_to_one",
      "input": {"bank_total": "100.0000", "business_total": "100.0000", "same_scope": true},
      "expected": {"review_status": "REVIEW_REQUIRED", "allocated_total": "100.0000", "bank_remainder": "0.0000", "business_remainder": "0.0000"},
      "forward_trace": ["receipt", "raw", "normalized", "staging", "review_plan"],
      "reverse_trace": ["review_plan", "staging", "source_version", "receipt_hash"]
    },
    {
      "id": "partial_match",
      "input": {"bank_total": "150.0000", "business_total": "100.0000", "same_scope": true},
      "expected": {"review_status": "PARTIAL_REVIEW_REQUIRED", "allocated_total": "100.0000", "bank_remainder": "50.0000", "business_remainder": "0.0000"},
      "forward_trace": ["receipt", "raw", "normalized", "staging", "review_plan"],
      "reverse_trace": ["review_plan", "staging", "source_version", "receipt_hash"]
    },
    {
      "id": "one_to_many",
      "input": {"bank_total": "100.0000", "business_total": "100.0000", "business_rows": 2},
      "expected": {"review_status": "REVIEW_REQUIRED", "allocation_edges": 2, "bank_remainder": "0.0000", "business_remainder": "0.0000"},
      "forward_trace": ["receipt", "raw", "normalized", "staging", "review_plan"],
      "reverse_trace": ["review_plan", "staging", "source_version", "receipt_hash"]
    },
    {
      "id": "many_to_one",
      "input": {"bank_total": "100.0000", "business_total": "100.0000", "bank_rows": 2},
      "expected": {"review_status": "REVIEW_REQUIRED", "allocation_edges": 2, "bank_remainder": "0.0000", "business_remainder": "0.0000"},
      "forward_trace": ["receipt", "raw", "normalized", "staging", "review_plan"],
      "reverse_trace": ["review_plan", "staging", "source_version", "receipt_hash"]
    },
    {
      "id": "amount_and_date_tolerance",
      "input": {"bank_total": "100.0000", "business_total": "100.0050", "amount_tolerance": "0.0100", "date_window_days": 2, "date_match_basis": "BUSINESS_AND_ACCOUNTING"},
      "expected": {"review_status": "REVIEW_REQUIRED", "difference": "0.0050", "date_match_basis": "BUSINESS_AND_ACCOUNTING", "can_allocate": false, "can_post": false},
      "forward_trace": ["policy_receipt", "mapping_version", "staging", "review_plan"],
      "reverse_trace": ["review_plan", "mapping_version", "policy_receipt"]
    },
    {
      "id": "cross_company_block",
      "input": {"bank_company": "COMPANY_A", "business_company": "COMPANY_B"},
      "expected": {"review_status": "BLOCKED", "exception_code": "WBS_AUTOREC_PLAN_SCOPE_MISMATCH", "candidate_count": 0},
      "forward_trace": ["receipt", "staging", "scope_check"],
      "reverse_trace": ["exception", "source_version", "receipt_hash"]
    },
    {
      "id": "duplicate_replay_block",
      "input": {"duplicate_source_key": true, "same_source_version": true},
      "expected": {"review_status": "BLOCKED", "exception_code": "WBS_AUTOREC_PLAN_SOURCE_DUPLICATE", "allocation_edges": 0},
      "forward_trace": ["receipt", "raw", "idempotency", "staging"],
      "reverse_trace": ["exception", "source_key", "source_version", "receipt_hash"]
    },
    {
      "id": "reopen_boundary",
      "input": {"observed_wbs_detail_sequence": ["RELEASED_PAYMENT", "INCURRED_PAYMENT"]},
      "expected": {"latest_observed_state": "INCURRED", "canonical_wbs_transition_graph": "UNKNOWN", "can_transition_state": false, "can_post": false},
      "forward_trace": ["receipt", "observed_detail", "state_history", "workflow_evidence"],
      "reverse_trace": ["state_history", "workflow_evidence", "source_version", "receipt_hash"]
    },
    {
      "id": "nul_company_isolation",
      "input": {"bank_company": "COMPANY_A", "business_company": "NUL"},
      "expected": {"review_status": "BLOCKED", "candidate_count": 0, "cross_company_write": false},
      "forward_trace": ["receipt", "staging", "scope_check"],
      "reverse_trace": ["exception", "source_version", "receipt_hash"]
    },
    {
      "id": "invalid_2064_date_quarantined",
      "input": {"business_date": "2064-02-30", "posting_date": "2064-02-30"},
      "expected": {"review_status": "BLOCKED", "candidate_count": 0, "draft_request": false},
      "forward_trace": ["receipt", "normalized", "date_validation", "exception"],
      "reverse_trace": ["exception", "source_version", "receipt_hash"]
    },
    {
      "id": "posted_291001_trace",
      "input": {"payable_incur_posted": true, "autoc_posted": true, "reviewed_allocation_amount": "100.0000", "member_291001_net": "0.0000"},
      "expected": {"g11_status": "POSTED_TRACE_VERIFIED", "clearing_amount_equals_reviewed_allocation": true, "can_transition_case": false, "can_post": false},
      "forward_trace": ["receipt", "staging", "posted_payable_incur", "posted_autoc", "ledger"],
      "reverse_trace": ["ledger", "journal_audit", "staging", "receipt_hash"]
    },
    {
      "id": "report_as_source_blocked",
      "input": {"source_types": ["COST_GENERAL_LEDGER", "PROPERTY_COMPARISON"], "control_only": true},
      "expected": {"review_status": "BLOCKED", "candidate_count": 0, "draft_request": false, "posting": false, "allowed_control_statuses": ["RECONCILED", "DIFFERENCE"]},
      "forward_trace": ["control_receipt", "wbs_control_snapshot", "approved_mapping", "refs_metric_snapshot", "control_comparison"],
      "reverse_trace": ["control_comparison", "refs_metric_snapshot", "mapping_version", "wbs_control_snapshot", "control_receipt"]
    }
  ]
}
