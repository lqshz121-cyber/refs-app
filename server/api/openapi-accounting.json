{
  "openapi":"3.1.0",
  "info":{"title":"REFS Accounting Command API","version":"1.0.0"},
  "servers":[{"url":"/api/v1"}],
  "security":[{"bearerAuth":[]}],
  "paths":{
    "/entities/{entityId}/attachments/reservations":{"post":{"operationId":"reserveAttachment","parameters":[{"$ref":"#/components/parameters/EntityId"},{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"$ref":"#/components/requestBodies/AttachmentReservation"},"responses":{"201":{"$ref":"#/components/responses/CommandCreated"},"default":{"$ref":"#/components/responses/Problem"}}}},
    "/entities/{entityId}/attachments/{attachmentId}/finalize":{"post":{"operationId":"finalizeAttachment","parameters":[{"$ref":"#/components/parameters/EntityId"},{"$ref":"#/components/parameters/AttachmentId"},{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"$ref":"#/components/requestBodies/EmptyCommand"},"responses":{"201":{"$ref":"#/components/responses/CommandCreated"},"default":{"$ref":"#/components/responses/Problem"}}}},
    "/entities/{entityId}/journal-entries/manual":{"post":{"operationId":"createManualJournal","parameters":[{"$ref":"#/components/parameters/EntityId"},{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"$ref":"#/components/requestBodies/ManualJournal"},"responses":{"201":{"$ref":"#/components/responses/CommandCreated"},"default":{"$ref":"#/components/responses/Problem"}}}},
    "/entities/{entityId}/journal-entries/auto":{"post":{"operationId":"createAutoJournal","parameters":[{"$ref":"#/components/parameters/EntityId"},{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"$ref":"#/components/requestBodies/AutoJournal"},"responses":{"201":{"$ref":"#/components/responses/CommandCreated"},"default":{"$ref":"#/components/responses/Problem"}}}},
    "/entities/{entityId}/journal-entries/{journalEntryId}/transitions/{action}":{"post":{"operationId":"transitionJournal","parameters":[{"$ref":"#/components/parameters/EntityId"},{"$ref":"#/components/parameters/JournalEntryId"},{"name":"action","in":"path","required":true,"schema":{"type":"string","enum":["submit","review","approve","reject"]}},{"$ref":"#/components/parameters/IdempotencyKey"},{"$ref":"#/components/parameters/IfMatch"}],"requestBody":{"$ref":"#/components/requestBodies/Transition"},"responses":{"201":{"$ref":"#/components/responses/CommandCreated"},"default":{"$ref":"#/components/responses/Problem"}}}},
    "/entities/{entityId}/journal-entries/{journalEntryId}/post":{"post":{"operationId":"postJournal","parameters":[{"$ref":"#/components/parameters/EntityId"},{"$ref":"#/components/parameters/JournalEntryId"},{"$ref":"#/components/parameters/IdempotencyKey"},{"$ref":"#/components/parameters/IfMatch"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["periodId"],"properties":{"periodId":{"$ref":"#/components/schemas/Uuid"}}}}}},"responses":{"201":{"$ref":"#/components/responses/CommandCreated"},"default":{"$ref":"#/components/responses/Problem"}}}},
    "/entities/{entityId}/journal-entries/{journalEntryId}/adjustments/{action}":{"post":{"operationId":"createJournalAdjustment","parameters":[{"$ref":"#/components/parameters/EntityId"},{"$ref":"#/components/parameters/JournalEntryId"},{"name":"action","in":"path","required":true,"schema":{"type":"string","enum":["reversal","reclass"]}},{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"$ref":"#/components/requestBodies/Adjustment"},"responses":{"201":{"$ref":"#/components/responses/CommandCreated"},"default":{"$ref":"#/components/responses/Problem"}}}}
  },
  "components":{
    "securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"JWT"}},
    "schemas":{
      "Uuid":{"type":"string","format":"uuid"},
      "Money":{"type":"number","multipleOf":0.0001},
      "JournalLine":{"type":"object","additionalProperties":false,"required":["line_no","account_code","debit_amount","credit_amount"],"properties":{"line_no":{"type":"integer","minimum":1},"account_code":{"type":"string","minLength":1},"debit_amount":{"$ref":"#/components/schemas/Money"},"credit_amount":{"$ref":"#/components/schemas/Money"},"member_ref":{"type":["string","null"]},"description":{"type":["string","null"]},"dimensions":{"type":"object"}}},
      "CommandEnvelope":{"type":"object","additionalProperties":false,"required":["ok","data"],"properties":{"ok":{"const":true},"data":{"type":"object"}}},
      "Problem":{"type":"object","additionalProperties":false,"required":["ok","code","message"],"properties":{"ok":{"const":false},"code":{"type":"string"},"message":{"type":"string"}}}
    },
    "parameters":{
      "EntityId":{"name":"entityId","in":"path","required":true,"schema":{"$ref":"#/components/schemas/Uuid"}},
      "AttachmentId":{"name":"attachmentId","in":"path","required":true,"schema":{"$ref":"#/components/schemas/Uuid"}},
      "JournalEntryId":{"name":"journalEntryId","in":"path","required":true,"schema":{"$ref":"#/components/schemas/Uuid"}},
      "IdempotencyKey":{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","minLength":8,"maxLength":200}},
      "IfMatch":{"name":"If-Match","in":"header","required":true,"schema":{"type":"string","pattern":"^(W/)?\\\"?[0-9]+\\\"?$"}}
    },
    "requestBodies":{
      "AttachmentReservation":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["name","mediaType","sizeBytes","contentHash"],"properties":{"name":{"type":"string","minLength":1,"maxLength":255,"pattern":"^[^/\\\\]+$"},"mediaType":{"type":"string","enum":["application/pdf","image/png","image/jpeg","text/csv"]},"sizeBytes":{"type":"integer","minimum":1,"maximum":52428800},"contentHash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}}}},
      "EmptyCommand":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"maxProperties":0}}}},
      "ManualJournal":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["periodId","journalNumber","journalDate","currency","lines","attachmentIds"],"properties":{"periodId":{"$ref":"#/components/schemas/Uuid"},"journalNumber":{"type":"string","minLength":1},"journalDate":{"type":"string","format":"date"},"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"description":{"type":["string","null"]},"lines":{"type":"array","minItems":2,"items":{"$ref":"#/components/schemas/JournalLine"}},"attachmentIds":{"type":"array","minItems":1,"items":{"$ref":"#/components/schemas/Uuid"}}}}}}},
      "AutoJournal":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["stagingItemId","periodId","expectedStagingVersion","journalNumber","lines"],"properties":{"stagingItemId":{"$ref":"#/components/schemas/Uuid"},"periodId":{"$ref":"#/components/schemas/Uuid"},"expectedStagingVersion":{"type":"integer","minimum":0},"journalNumber":{"type":"string","minLength":1},"description":{"type":["string","null"]},"lines":{"type":"array","minItems":2,"items":{"$ref":"#/components/schemas/JournalLine"}}}}}}},
      "Transition":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"properties":{"reason":{"type":["string","null"]}}}}}},
      "Adjustment":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["periodId","journalNumber","journalDate","reason"],"properties":{"periodId":{"$ref":"#/components/schemas/Uuid"},"journalNumber":{"type":"string","minLength":1},"journalDate":{"type":"string","format":"date"},"description":{"type":["string","null"]},"reason":{"type":"string","minLength":8},"lines":{"type":["array","null"],"items":{"$ref":"#/components/schemas/JournalLine"}},"attachmentIds":{"type":"array","items":{"$ref":"#/components/schemas/Uuid"}}}}}}}
    },
    "responses":{"CommandCreated":{"description":"Command accepted or idempotently replayed","headers":{"Cache-Control":{"schema":{"const":"no-store"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommandEnvelope"}}}},"Problem":{"description":"Fail-closed command error","headers":{"Cache-Control":{"schema":{"const":"no-store"}}},"content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}}}
  }
}
