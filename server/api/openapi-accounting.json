  "components":{
    "securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"JWT"}},
    "schemas":{
      "Uuid":{"type":"string","format":"uuid"},
      "Money":{"type":"number","multipleOf":0.0001},
      "JournalLine":{"type":"object","additionalProperties":false,"required":["line_no","account_code","debit_amount","credit_amount"],"properties":{"line_no":{"type":"integer","minimum":1},"account_code":{"type":"string","minLength":1},"debit_amount":{"$ref":"#/components/schemas/Money"},"credit_amount":{"$ref":"#/components/schemas/Money"},"member_ref":{"type":["string","null"]},"description":{"type":["string","null"]},"dimensions":{"type":"object"}}},
      "ApVendorCreditLine":{"type":"object","additionalProperties":false,"required":["line_no","account_code","amount"],"properties":{"line_no":{"type":"integer","minimum":1},"account_code":{"type":"string","minLength":1},"amount":{"$ref":"#/components/schemas/Money"},"member_ref":{"type":["string","null"]},"description":{"type":["string","null"]},"dimensions":{"type":"object"}}},
      "CommandEnvelope":{"type":"object","additionalProperties":false,"required":["ok","data"],"properties":{"ok":{"const":true},"data":{"type":"object"}}},
      "AttachmentResult":{"type":"object","additionalProperties":false,"required":["attachment_id","entity_id","status","idempotent"],"properties":{"attachment_id":{"$ref":"#/components/schemas/Uuid"},"entity_id":{"$ref":"#/components/schemas/Uuid"},"status":{"type":"string","enum":["PENDING","VERIFIED_CLEAN","REJECTED"]},"idempotent":{"type":"boolean"},"upload_url":{"type":"string","format":"uri"},"required_headers":{"type":"object","additionalProperties":{"type":"string"}},"upload_expires_at":{"type":"string","format":"date-time"}}},
      "AttachmentEnvelope":{"type":"object","additionalProperties":false,"required":["ok","data"],"properties":{"ok":{"const":true},"data":{"$ref":"#/components/schemas/AttachmentResult"}}},
      "Problem":{"type":"object","additionalProperties":false,"required":["ok","code","message"],"properties":{"ok":{"const":false},"code":{"type":"string"},"message":{"type":"string"}}}
    },
    "parameters":{
      "EntityId":{"name":"entityId","in":"path","required":true,"schema":{"$ref":"#/components/schemas/Uuid"}},
      "BusinessDocumentId":{"name":"businessDocumentId","in":"path","required":true,"schema":{"$ref":"#/components/schemas/Uuid"}},
      "BusinessAdjustmentId":{"name":"businessAdjustmentId","in":"path","required":true,"schema":{"$ref":"#/components/schemas/Uuid"}},
      "SourceOccurrenceId":{"name":"sourceOccurrenceId","in":"path","required":true,"schema":{"$ref":"#/components/schemas/Uuid"}},
      "AttachmentId":{"name":"attachmentId","in":"path","required":true,"schema":{"$ref":"#/components/schemas/Uuid"}},
      "JournalEntryId":{"name":"journalEntryId","in":"path","required":true,"schema":{"$ref":"#/components/schemas/Uuid"}},
      "IdempotencyKey":{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","minLength":8,"maxLength":200}},
      "IfMatch":{"name":"If-Match","in":"header","required":true,"schema":{"type":"string","pattern":"^\\\"?[0-9]+\\\"?$"}}
    },
    "requestBodies":{
      "AttachmentReservation":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["name","mediaType","sizeBytes","contentHash"],"properties":{"name":{"type":"string","minLength":1,"maxLength":255,"pattern":"^[^/\\\\]+$"},"mediaType":{"type":"string","enum":["application/pdf","image/png","image/jpeg","text/csv"]},"sizeBytes":{"type":"integer","minimum":1,"maximum":52428800},"contentHash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}}}},
      "EmptyCommand":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"maxProperties":0}}}},
      "ManualJournal":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["periodId","journalNumber","journalDate","currency","lines","attachmentIds"],"properties":{"periodId":{"$ref":"#/components/schemas/Uuid"},"journalNumber":{"type":"string","minLength":1},"journalDate":{"type":"string","format":"date"},"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"description":{"type":["string","null"]},"lines":{"type":"array","minItems":2,"items":{"$ref":"#/components/schemas/JournalLine"}},"attachmentIds":{"type":"array","minItems":1,"items":{"$ref":"#/components/schemas/Uuid"}}}}}}},
      "AutoJournal":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["stagingItemId","periodId","expectedStagingVersion","journalNumber","lines"],"properties":{"stagingItemId":{"$ref":"#/components/schemas/Uuid"},"periodId":{"$ref":"#/components/schemas/Uuid"},"expectedStagingVersion":{"type":"integer","minimum":0},"journalNumber":{"type":"string","minLength":1},"description":{"type":["string","null"]},"lines":{"type":"array","minItems":2,"items":{"$ref":"#/components/schemas/JournalLine"}}}}}}},
      "Transition":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"properties":{"reason":{"type":["string","null"]}}}}}},
      "Adjustment":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["periodId","journalNumber","journalDate","reason"],"properties":{"periodId":{"$ref":"#/components/schemas/Uuid"},"journalNumber":{"type":"string","minLength":1},"journalDate":{"type":"string","format":"date"},"description":{"type":["string","null"]},"reason":{"type":"string","minLength":8},"lines":{"type":["array","null"],"items":{"$ref":"#/components/schemas/JournalLine"}},"attachmentIds":{"type":"array","items":{"$ref":"#/components/schemas/Uuid"}}}}}}},
      "ApBillVoid":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["periodId","journalNumber","journalDate","reason"],"properties":{"periodId":{"$ref":"#/components/schemas/Uuid"},"journalNumber":{"type":"string","minLength":1},"journalDate":{"type":"string","format":"date"},"reason":{"type":"string","minLength":8}}}}}},
      "ApPayment":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["periodId","paymentNumber","paymentDate","cashAccountCode","amount","reason"],"properties":{"periodId":{"$ref":"#/components/schemas/Uuid"},"paymentNumber":{"type":"string","minLength":1},"paymentDate":{"type":"string","format":"date"},"cashAccountCode":{"type":"string","minLength":1},"bankMemberRef":{"type":["string","null"]},"amount":{"$ref":"#/components/schemas/Money"},"reason":{"type":"string","minLength":8}}}}}},
      "ApVendorCredit":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["periodId","creditNumber","creditDate","vendorRef","vendorName","amount","lines","reason"],"properties":{"periodId":{"$ref":"#/components/schemas/Uuid"},"creditNumber":{"type":"string","minLength":1},"creditDate":{"type":"string","format":"date"},"vendorRef":{"type":"string","minLength":1},"vendorName":{"type":"string","minLength":1},"amount":{"$ref":"#/components/schemas/Money"},"lines":{"type":"array","minItems":1,"items":{"$ref":"#/components/schemas/ApVendorCreditLine"}},"reason":{"type":"string","minLength":8}}}}}},
      "ApVendorCreditAllocation":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["businessDocumentId","amount","reason"],"properties":{"businessDocumentId":{"$ref":"#/components/schemas/Uuid"},"amount":{"$ref":"#/components/schemas/Money"},"reason":{"type":"string","minLength":8}}}}}},
      "ArReceipt":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["periodId","receiptNumber","receiptDate","cashAccountCode","amount","reason"],"properties":{"periodId":{"$ref":"#/components/schemas/Uuid"},"receiptNumber":{"type":"string","minLength":1},"receiptDate":{"type":"string","format":"date"},"cashAccountCode":{"type":"string","minLength":1},"bankMemberRef":{"type":["string","null"]},"amount":{"$ref":"#/components/schemas/Money"},"reason":{"type":"string","minLength":8}}}}}},
      "ArReceiptReversal":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["periodId","journalNumber","journalDate","reason"],"properties":{"periodId":{"$ref":"#/components/schemas/Uuid"},"journalNumber":{"type":"string","minLength":1},"journalDate":{"type":"string","format":"date"},"reason":{"type":"string","minLength":8}}}}}}
      ,"ArCreditMemo":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["periodId","memoNumber","memoDate","customerRef","customerName","amount","lines","reason"],"properties":{"periodId":{"$ref":"#/components/schemas/Uuid"},"memoNumber":{"type":"string","minLength":1},"memoDate":{"type":"string","format":"date"},"customerRef":{"type":"string","minLength":1},"customerName":{"type":"string","minLength":1},"amount":{"$ref":"#/components/schemas/Money"},"lines":{"type":"array","minItems":1,"items":{"$ref":"#/components/schemas/ApVendorCreditLine"}},"reason":{"type":"string","minLength":8}}}}}},"Allocation":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["businessDocumentId","amount","reason"],"properties":{"businessDocumentId":{"$ref":"#/components/schemas/Uuid"},"amount":{"$ref":"#/components/schemas/Money"},"reason":{"type":"string","minLength":8}}}}}}
    },
    "responses":{"CommandCreated":{"description":"New command accepted","headers":{"Cache-Control":{"schema":{"const":"no-store"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommandEnvelope"}}}},"CommandReplay":{"description":"Idempotent replay of a completed command","headers":{"Cache-Control":{"schema":{"const":"no-store"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommandEnvelope"}}}},"AttachmentCreated":{"description":"New attachment command accepted","headers":{"Cache-Control":{"schema":{"const":"no-store"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AttachmentEnvelope"}}}},"AttachmentReplay":{"description":"Idempotent replay of a completed attachment command","headers":{"Cache-Control":{"schema":{"const":"no-store"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AttachmentEnvelope"}}}},"Problem":{"description":"Fail-closed command error","headers":{"Cache-Control":{"schema":{"const":"no-store"}}},"content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}}}
  }
}
