    "/entities/{entityId}/ar/credit-memos/{businessAdjustmentId}/allocations":{"post":{"operationId":"applyArCreditMemo","parameters":[{"$ref":"#/components/parameters/EntityId"},{"$ref":"#/components/parameters/BusinessAdjustmentId"},{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"$ref":"#/components/requestBodies/Allocation"},"responses":{"200":{"$ref":"#/components/responses/CommandReplay"},"201":{"$ref":"#/components/responses/CommandCreated"},"default":{"$ref":"#/components/responses/Problem"}}}}
