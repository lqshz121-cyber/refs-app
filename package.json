{
  "name": "refs-app",
  "version": "0.1.0",
  "private": true,
  "description": "REFS - Real Estate Financial System (WanBridge) functional prototype",
  "scripts": {
    "build": "node build.mjs && node scripts/write-runtime-config.mjs",
    "dev": "node build.mjs --watch",
    "test": "npm run test:ssr && npm run test:authoritative-bank && npm run test:wbs-accounting-foundation && npm run test:wbs-accounting-acceptance && npm run test:ap-ar && npm run test:api-client && npm run test:attachment-client && npm run test:oidc && npm run test:runtime-config && npm run test:ai-draft-je-contract && npm run test:ai-review-outcome-contract && npm run test:navigation-a11y && npm run test:workflow && npm run test:autorecon && npm run test:audit && npm run test:visual && npm run test:release-harness && npm run test:release-simulation && npm run test:release-evidence-bundle",
    "test:ap-ar": "esbuild ./tests/ap-ar-workflow.test.jsx --bundle --platform=node --format=cjs --outfile=tests/ap-ar-workflow.test.cjs && node tests/ap-ar-workflow.test.cjs",
    "test:api-client": "esbuild ./tests/accounting-api-client.test.js --bundle --platform=node --format=cjs --outfile=tests/accounting-api-client.test.cjs && node tests/accounting-api-client.test.cjs",
    "test:authoritative-bank": "esbuild ./tests/authoritative-bank-workspace.test.jsx --bundle --platform=node --format=cjs --jsx=automatic --loader:.js=jsx --loader:.jsx=jsx --outfile=tests/authoritative-bank-workspace.test.cjs && node tests/authoritative-bank-workspace.test.cjs",
    "test:attachment-client": "esbuild ./tests/attachment-api-client.test.js --bundle --platform=node --format=cjs --outfile=tests/attachment-api-client.test.cjs && node tests/attachment-api-client.test.cjs",
    "test:oidc": "esbuild ./tests/oidc-client.test.js --bundle --platform=node --format=cjs --outfile=tests/oidc-client.test.cjs && node tests/oidc-client.test.cjs",
    "test:runtime-config": "esbuild ./tests/runtime-config.test.js --bundle --platform=node --format=cjs --outfile=tests/runtime-config.test.cjs && node tests/runtime-config.test.cjs",
    "test:ai-draft-je-contract": "esbuild ./tests/ai-draft-je-contract.test.js --bundle --platform=node --format=cjs --outfile=tests/ai-draft-je-contract.test.cjs && node tests/ai-draft-je-contract.test.cjs",
    "test:ai-review-outcome-contract": "esbuild ./tests/ai-review-outcome-contract.test.js --bundle --platform=node --format=cjs --outfile=tests/ai-review-outcome-contract.test.cjs && node tests/ai-review-outcome-contract.test.cjs",
    "test:navigation-a11y": "esbuild ./tests/navigation-a11y.test.js --bundle --platform=node --format=cjs --outfile=tests/navigation-a11y.test.cjs && node tests/navigation-a11y.test.cjs",
    "test:workflow": "esbuild ./tests/authoritative-workflow.test.js --bundle --platform=node --format=cjs --outfile=tests/authoritative-workflow.test.cjs && node tests/authoritative-workflow.test.cjs",
    "test:ssr": "esbuild ./mtest.jsx --bundle --platform=node --format=cjs --jsx=automatic --loader:.js=jsx --loader:.jsx=jsx --outfile=mtest.cjs && node mtest.cjs",
    "test:wbs-accounting-foundation": "esbuild ./tests/wbs-accounting-foundation.test.js --bundle --platform=node --format=cjs --outfile=tests/wbs-accounting-foundation.test.cjs && node tests/wbs-accounting-foundation.test.cjs",
    "test:wbs-accounting-acceptance": "esbuild ./tests/wbs-accounting-acceptance.test.js --bundle --platform=node --format=cjs --outfile=tests/wbs-accounting-acceptance.test.cjs && node tests/wbs-accounting-acceptance.test.cjs",
    "test:audit": "esbuild ./audit.js --bundle --platform=node --format=cjs --jsx=automatic --loader:.js=jsx --loader:.jsx=jsx --outfile=audit.cjs && node audit.cjs",
    "test:autorecon": "esbuild ./tests/autorecon-fail-closed.test.jsx --bundle --platform=node --format=cjs --jsx=automatic --loader:.js=jsx --loader:.jsx=jsx --outfile=tests/autorecon-fail-closed.test.cjs && node tests/autorecon-fail-closed.test.cjs",
    "test:visual": "npm run build && node tools/run-verifiers.mjs",
    "test:release-harness": "node tools/verify-external-release-gate.test.mjs",
    "test:release-simulation": "node tools/verify-local-release-simulation.test.mjs",
    "test:release-evidence-bundle": "node tools/create-release-evidence-bundle.test.mjs",
    "create:release-evidence-bundle": "node tools/create-release-evidence-bundle.mjs --strict-clean",
    "verify:external-release-gate": "node tools/verify-external-release-gate.mjs all",
    "verify:release-ui-e2e": "node tools/verify-external-release-gate.mjs ui",
    "verify:release-s3-scanner": "node tools/verify-external-release-gate.mjs s3",
    "verify:release-wbs-receipt": "node tools/verify-external-release-gate.mjs wbs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
